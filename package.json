{
  "name": "@gnaroshi/content-feed-contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild scripts/feed-validation.mjs --bundle --platform=node --format=cjs --target=node20 --outfile=dist/feed-validate.cjs",
