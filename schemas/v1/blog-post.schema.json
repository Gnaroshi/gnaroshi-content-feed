{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnaroshi.dev/schemas/v1/blog-post.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 }, "schemaVersion": { "const": 1 },
    "createdAt": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/timestamp" }, "updatedAt": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/timestamp" },
    "visibility": { "enum": ["public", "unlisted"] }, "contentStage": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/contentStage" },
    "metricEligible": { "type": "boolean" }, "graphEligible": { "type": "boolean" }, "weeklyReviewEligible": { "type": "boolean" },
    "category": { "enum": ["research-note", "implementation-note", "paper-note", "build-note", "essay"] },
    "locale": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/locale" }, "translationKey": { "type": "string", "minLength": 1 },
    "translationStatus": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/translationStatus" },
    "canonicalSlug": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/slug" }, "aliases": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/aliases" },
    "title": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 },
    "publishDate": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/date" }, "updatedDate": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/date" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "series": { "type": "string", "minLength": 1 }, "seriesOrder": { "type": "integer", "minimum": 1 },
    "featured": { "type": "boolean" }, "heroImage": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/publicPath" },
    "ogImage": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/publicPath" }, "canonicalUrl": { "type": "string", "format": "uri" },
    "assets": { "type": "array", "items": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/publicPath" }, "uniqueItems": true }
  },
  "required": ["id", "schemaVersion", "createdAt", "updatedAt", "visibility", "contentStage", "metricEligible", "graphEligible", "weeklyReviewEligible", "category", "locale", "translationKey", "translationStatus", "canonicalSlug", "aliases", "title", "description", "publishDate", "tags", "featured", "assets"]
}
