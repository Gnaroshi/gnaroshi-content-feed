{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://gnaroshi.dev/schemas/v1/weekly-review.schema.json",
  "type": "object", "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 }, "schemaVersion": { "const": 1 }, "weekId": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "startDate": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/date" }, "endDate": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/date" },
    "generatedAt": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/timestamp" }, "closedAt": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/timestamp" }, "visibility": { "enum": ["public", "unlisted"] },
    "state": { "enum": ["in-progress", "complete", "insufficient-evidence"] }, "meaningfulEventCount": { "type": "integer", "minimum": 0 },
    "summary": { "type": "string", "minLength": 1 },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "readingSessions": { "type": "integer", "minimum": 0 }, "distinctPapersTouched": { "type": "integer", "minimum": 0 }, "readingMinutes": { "type": "integer", "minimum": 0 },
        "activeDays": { "type": "integer", "minimum": 0 }, "completedPasses": { "type": "integer", "minimum": 0 }, "revisits": { "type": "integer", "minimum": 0 },
        "reviews": { "type": "integer", "minimum": 0 }, "oralExams": { "type": "integer", "minimum": 0 }, "formulaRecalls": { "type": "integer", "minimum": 0 },
        "implementations": { "type": "integer", "minimum": 0 }, "posts": { "type": "integer", "minimum": 0 }
      },
      "minProperties": 1
    },
    "strongestDimension": { "type": ["string", "null"] }, "weakestDimension": { "type": ["string", "null"] },
    "wins": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "openLoops": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nextActions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "featuredItems": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "recordType": { "enum": ["paper", "blog", "implementation"] }, "recordId": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "href": { "type": "string", "pattern": "^/" } }, "required": ["recordType", "recordId", "title", "href"] } }
  },
  "required": ["id", "schemaVersion", "weekId", "startDate", "endDate", "generatedAt", "visibility", "state", "meaningfulEventCount", "summary", "metrics", "wins", "openLoops", "nextActions", "featuredItems"],
  "allOf": [
    { "if": { "properties": { "meaningfulEventCount": { "maximum": 1 } }, "required": ["meaningfulEventCount"] }, "then": { "properties": { "state": { "enum": ["in-progress", "insufficient-evidence"] }, "strongestDimension": { "type": "null" }, "weakestDimension": { "type": "null" } } } }
  ]
}
