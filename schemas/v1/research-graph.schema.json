{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://gnaroshi.dev/schemas/v1/research-graph.schema.json",
  "type": "object", "additionalProperties": false,
  "properties": {
    "id": { "const": "research-graph" }, "schemaVersion": { "const": 1 }, "generatedAt": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/timestamp" },
    "eligible": { "type": "boolean" }, "eligibilityThreshold": { "type": "integer", "minimum": 1 },
    "nodes": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "nodeType": { "enum": ["paper", "post", "project", "implementation", "question", "topic", "formula", "weekly-review"] },
          "locale": { "$ref": "https://gnaroshi.dev/schemas/index.json#/$defs/locale" }, "label": { "type": "string", "minLength": 1 }, "href": { "type": "string", "pattern": "^/" },
          "description": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "required": ["id", "nodeType", "locale", "label", "href", "tags"]
      }
    },
    "edges": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "sourceId": { "type": "string", "minLength": 1 }, "targetId": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["cites", "inspires", "contradicts", "extends", "implements", "explains", "critiques", "depends-on", "revisits", "tagged", "relates-to", "writes-about", "reviews"] },
          "inferred": { "type": "boolean" }
        },
        "required": ["id", "sourceId", "targetId", "relation", "inferred"]
      }
    }
  },
  "required": ["id", "schemaVersion", "generatedAt", "eligible", "eligibilityThreshold", "nodes", "edges"]
}
